pe":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/webhooks/quickstart?lang=ruby"},"children":["Ruby ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/webhooks/quickstart?lang=node"},"children":["NodeJS ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/webhooks/quickstart?lang=php"},"children":["PHP ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/webhooks/quickstart?lang=python"},"children":["Python ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/webhooks/quickstart?lang=go"},"children":["Go ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/webhooks/quickstart?lang=dotnet"},"children":[".NET ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/webhooks/quickstart?lang=java"},"children":["Java ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://docs.stripe.com/cli/listen"},"children":["Stripe CLI ↗"]}," forwards events to localhost — see ",{"$$mdtype":"Tag","name":"a","attributes":{"href":"/ops-experience/testing"},"children":["Testing and Local Development"]}]}]}]}]}]}]},{"$$mdtype":"Tag","name":"hr","attributes":{},"children":[]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"sample-validation"},"children":["Sample Validation"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["Stripe recommends its SDKs for verification. If you verify manually:"]},{"$$mdtype":"Tag","name":"Fence","attributes":{"language":"js"},"children":["const crypto = require('crypto')\nconst express = require('express')\nconst app = express()\n\nconst sigHeader = 'Stripe-Signature'\nconst hashAlgo = 'sha256'\nconst encode = 'hex'\nconst hmacSecret = process.env.WEBHOOK_SECRET\n\n// Use the raw body: re-serialized JSON will not match the signature\napp.post('/stripe-webhook', express.raw({ type: 'application/json' }), (req, res) => {\n    //01: Get timestamp and every v1 signature (there may be several during rotation)\n    const elements = (req.get(sigHeader) || '').split(',').map(e => e.split('='))\n    const timestamp = (elements.find(([k]) => k === 't') || [])[1]\n    const signatures = elements.filter(([k]) => k === 'v1').map(([, v]) => v)\n\n    //02: Validate replay prevention with 5 minute timeframe\n    if (!timestamp || Math.abs(Date.now() - timestamp * 1000) > 5 * 60 * 1000) {\n        return res.status(403).send('Request expired')\n    }\n\n    //03: Validate signature against each v1 value\n    const message = `${timestamp}.${req.body.toString('utf8')}`\n    const digest = Buffer.from(crypto.createHmac(hashAlgo, hmacSecret).update(message).digest(encode), 'utf8')\n    const valid = signatures.some(sig => {\n        const providerSig = Buffer.from(sig, 'utf8')\n        return providerSig.length === digest.length && crypto.timingSafeEqual(digest, providerSig)\n    })\n    if (!valid) {\n        return res.status(401).send('Request unauthorized')\n    }\n    //04: Process message (dedupe on event id)\n    res.json({ message: \"Success\" })\n})\n"]}],"frontmatter":{"title":"Stripe Webhook Specs, Events, and Examples","pageTitle":"Stripe Webhooks Specs | Examples| How to integrate","description":"Webhook specificactions for Stripe including Supported Events, Example Apps, Security Specs, and Documentations."},"file":{"path":"/webhook-directory/stripe.md"}}},"__N_SSG":true}