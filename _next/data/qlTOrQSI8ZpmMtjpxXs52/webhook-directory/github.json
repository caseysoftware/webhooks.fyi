 expects a ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["2xx"]}," response within 10 seconds and does not retry failed deliveries automatically. See ",{"$$mdtype":"Tag","name":"a","attributes":{"href":"/ops-experience/retries"},"children":["Retries and Timeouts"]},"."]},{"$$mdtype":"Tag","name":"Fence","attributes":{"language":"js"},"children":["const crypto = require('crypto')\nconst express = require('express')\nconst app = express()\n\nconst sigHeader = 'X-Hub-Signature-256'\nconst hashAlgo = 'sha256'\nconst encode = 'hex'\nconst hmacSecret = process.env.WEBHOOK_SECRET\n\n// Use the raw body: re-serialized JSON will not match the signature\napp.post('/github-webhook', express.raw({ type: 'application/json' }), (req, res) => {\n  //01: Validate signature\n  const digest = Buffer.from('sha256=' +\n                  crypto.createHmac(hashAlgo, hmacSecret)\n                  .update(req.body).digest(encode), 'utf8')\n  const providerSig = Buffer.from(req.get(sigHeader) || '', 'utf8')\n  if (providerSig.length !== digest.length || !crypto.timingSafeEqual(digest, providerSig)) {\n      return res.status(401).send('Request unauthorized')\n  }\n  //02: Process message (dedupe on X-GitHub-Delivery)\n  res.json({ message: \"Success\" })\n})\n"]}],"frontmatter":{"title":"GitHub Webhook Specs, Events, and Examples","pageTitle":"GitHub Webhooks Specs | Examples| How to integrate","description":"Webhook specificactions for GitHub including Supported Events, Example Apps, Security Specs, and Documentations."},"file":{"path":"/webhook-directory/github.md"}}},"__N_SSG":true}