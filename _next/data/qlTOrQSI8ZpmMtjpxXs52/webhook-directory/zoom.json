$mdtype":"Tag","name":"strong","attributes":{},"children":["Encode"]},": hex"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Key"]},": your app's Secret Token"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["payload"]},": ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["v0:timestamp:request_body"]}," (raw bytes)"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Timestamp Header"]},": ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["x-zm-request-timestamp"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Timestamp Format"]},": Unix Date"]}]}]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"h2","attributes":{"id":"documentation"},"children":["Documentation"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"ul","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://developers.zoom.us/docs/api/webhooks/"},"children":["Official Doc ↗"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://developers.zoom.us/docs/api/webhooks/#ip-addresses"},"children":["IP Origins for allowlist ↗"]}]}]}]}]},{"$$mdtype":"Tag","name":"tr","attributes":{},"children":[{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"h2","attributes":{"id":"sd-ks-and-sample-code"},"children":["SDKs and Sample Code"]}]},{"$$mdtype":"Tag","name":"td","attributes":{},"children":[{"$$mdtype":"Tag","name":"ul","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"https://github.com/zoom/webhook-sample-node.js"},"children":["NodeJS Sample ↗"]}]}]}]}]}]}]},{"$$mdtype":"Tag","name":"hr","attributes":{},"children":[]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"url-validation"},"children":["URL Validation"]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":["When you add or change an endpoint — and every 72 hours after that — Zoom sends an ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["endpoint.url_validation"]}," event containing a ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["plainToken"]},". Your endpoint must respond within 3 seconds with the token and its HMAC, proving it holds the Secret Token. After six consecutive failed validations, Zoom disables the subscription. See ",{"$$mdtype":"Tag","name":"a","attributes":{"href":"/security/one-time-verification-challenge"},"children":["One Time Verification"]},"."]},{"$$mdtype":"Tag","name":"h2","attributes":{"id":"sample-validation"},"children":["Sample Validation"]},{"$$mdtype":"Tag","name":"Fence","attributes":{"language":"js"},"children":["const crypto = require('crypto')\nconst express = require('express')\nconst app = express()\n\nconst timeHeader = 'x-zm-request-timestamp'\nconst sigHeader = 'x-zm-signature'\nconst hashAlgo = 'sha256'\nconst encode = 'hex'\nconst hmacSecret = process.env.ZOOM_WEBHOOK_SECRET_TOKEN\n\n// Use the raw body: re-serialized JSON will not match the signature\napp.post('/zoom-webhook', express.raw({ type: 'application/json' }), (req, res) => {\n    //01: Validate replay prevention with 5 minute timeframe\n    const timestamp = req.get(timeHeader)\n    if (!timestamp || Math.abs(Date.now() - timestamp * 1000) > 5 * 60 * 1000) {\n        return res.status(403).send('Request expired')\n    }\n    //02: Validate signature\n    const message = `v0:${timestamp}:${req.body.toString('utf8')}`\n    const digest = Buffer.from('v0=' +\n                   crypto.createHmac(hashAlgo, hmacSecret).update(message).digest(encode), 'utf8')\n    const providerSig = Buffer.from(req.get(sigHeader) || '', 'utf8')\n    if (providerSig.length !== digest.length || !crypto.timingSafeEqual(digest, providerSig)) {\n        return res.status(401).send('Request unauthorized')\n    }\n    const event = JSON.parse(req.body)\n\n    //03: Answer the URL validation challenge\n    if (event.event === 'endpoint.url_validation') {\n        const plainToken = event.payload.plainToken\n        const encryptedToken = crypto.createHmac(hashAlgo, hmacSecret).update(plainToken).digest(encode)\n        return res.json({ plainToken, encryptedToken })\n    }\n    //04: Process message\n    res.json({ message: \"Success\" })\n})\n"]}],"frontmatter":{"title":"Zoom Webhook Specs, Events, and Examples","pageTitle":"Zoom Webhooks Specs | Examples | How to integrate","description":"Webhook specificactions for Zoom including Supported Events, Example Apps, Security Specs, and Documentations."},"file":{"path":"/webhook-directory/zoom.md"}}},"__N_SSG":true}