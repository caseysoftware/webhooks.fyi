alue>\" }"]}]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Twitch sends a ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["webhook_callback_verification"]}," message and expects the raw ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["challenge"]}," value"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["Discord sends a ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["PING"]}," interaction and expects a ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["PONG"]}," response"]}]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Prove you hold the secret."]}," The consumer returns an HMAC of the challenge, proving it has the signing secret — not just that it's listening."]},{"$$mdtype":"Tag","name":"ul","attributes":{},"children":[{"$$mdtype":"Tag","name":"li","attributes":{},"children":[{"$$mdtype":"Tag","name":"a","attributes":{"href":"/webhook-directory/zoom"},"children":["Zoom"]}," sends an ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["endpoint.url_validation"]}," event with a ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["plainToken"]},"; the consumer returns the token and its HMAC-SHA256 (",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["encryptedToken"]},") using the app's Secret Token"]},{"$$mdtype":"Tag","name":"li","attributes":{},"children":["X sends a ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["crc_token"]},"; the consumer returns ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["sha256="]}," plus the base64 HMAC-SHA256 of the token, keyed with the app's secret"]}]},{"$$mdtype":"Tag","name":"p","attributes":{},"children":[{"$$mdtype":"Tag","name":"strong","attributes":{},"children":["Exchange the secret."]}," Asana sends an ",{"$$mdtype":"Tag","name":"code","attributes":{},"children":["X-Hook-Secret"]}," header in its handshake; the